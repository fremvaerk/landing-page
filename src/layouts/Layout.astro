---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Aurora from '../components/Aurora.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import {
  CVR,
  EMAIL,
  GITHUB_URL,
  SITE_URL,
  absoluteUrl,
  alternates,
  routes,
  ui,
  type Lang,
  type PageKey,
} from '../i18n/ui';

interface Props {
  lang: Lang;
  /** The page key, or 'notFound' for the 404 page (no canonical and no hreflang). */
  page: PageKey | 'notFound';
  title: string;
  description: string;
  noindex?: boolean;
  /** The decorative aurora at the top. Only the landing pages use it. */
  aurora?: boolean;
}

const { lang, page, title, description, noindex = false, aurora = false } = Astro.props;
const t = ui[lang];
const other = lang === 'da' ? ui.en : ui.da;

const canonical = page === 'notFound' ? undefined : absoluteUrl(routes[page][lang]);
const hreflangLinks = page === 'notFound' ? [] : alternates(page);
const shareImage = absoluteUrl('/og.png');

// Matches --ground in src/styles/tokens.css (HTML meta tags cannot read CSS variables).
const themeColor = '#070b14';

const organization =
  page === 'home'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'FremVærk',
        url: `${SITE_URL}/`,
        email: EMAIL,
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Birkerød',
          addressCountry: 'DK',
        },
        vatID: `DK${CVR}`,
        sameAs: [GITHUB_URL],
      }
    : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {hreflangLinks.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}

    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FremVærk" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={t.locale} />
    <meta property="og:locale:alternate" content={other.locale} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={t.shareImageAlt} />

    {organization && <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipLink}</a>
    <div class="site">
      {aurora && <Aurora />}
      <Header lang={lang} page={page} />
      <main id="main">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
  </body>
</html>
