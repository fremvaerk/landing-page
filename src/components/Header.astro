---
import { routes, sectionIds, ui, type Lang, type PageKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: PageKey | 'notFound';
}

const { lang, page } = Astro.props;
const t = ui[lang];
const ids = sectionIds[lang];

// On the landing page the section links stay on the page. On other pages they go to the landing page.
const home = routes.home[lang];
const base = page === 'home' ? '' : home;
const projectsHref = `${base}#${ids.projects}`;
const contactHref = `${base}#${ids.contact}`;

// The language switch goes to the same page in the other language.
const langHref = (target: Lang): string => (page === 'notFound' ? routes.home[target] : routes[page][target]);
---

<header class="site-header container">
  <a class="wordmark" href={home} aria-label={t.homeLabel}>FremVærk</a>
  <nav class="nav" aria-label={t.navLabel}>
    <a class="nav-link" href={projectsHref}>{t.navProjects}</a>
    <a class="nav-link" href={contactHref}>{t.navContact}</a>
    <span class="lang-switch"><a href={langHref('da')} lang="da" hreflang="da" aria-current={lang === 'da' ? 'true' : undefined}>DA</a> <span aria-hidden="true">/</span> <a href={langHref('en')} lang="en" hreflang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a></span>
    <a class="header-button" href={contactHref}>{t.headerButton}</a>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding-block: 22px;
  }

  .wordmark {
    color: var(--heading);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--link-hover);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 28px;
    font-size: 0.9375rem;
  }

  .nav-link {
    text-decoration: none;
  }

  .lang-switch {
    color: var(--muted);
    white-space: nowrap;
  }

  .lang-switch a[aria-current] {
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  .header-button {
    padding: 10px 18px;
    border: 1px solid var(--btn-border);
    border-radius: 999px;
    color: var(--text);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .header-button:hover {
    border-color: var(--input-border);
    color: var(--link-hover);
  }

  /* Phone: one row with the wordmark, the language switch and the button. */
  @media (max-width: 639.98px) {
    .site-header {
      gap: 12px;
      padding-block: 16px;
    }

    .nav {
      gap: 10px 16px;
    }

    .nav-link {
      display: none;
    }
  }
</style>
